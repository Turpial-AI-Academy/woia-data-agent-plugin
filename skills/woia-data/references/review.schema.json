{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woia:data:review-envelope:v1",
  "type": "object",
  "required": [
    "organization",
    "scope",
    "intended_use",
    "business_owner",
    "correlation_id",
    "responsibility",
    "effect",
    "contract",
    "source_authority",
    "source_status",
    "evidence",
    "trusted_actor"
  ],
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "business_owner": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "responsibility": {
      "enum": [
        "agreements",
        "identity-source",
        "suitability",
        "change-migration",
        "integrity-controls"
      ]
    },
    "effect": {
      "const": "evaluation"
    },
    "source_status": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "version",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "const": true
        }
      }
    },
    "source_authority": {
      "type": "object",
      "required": [
        "source",
        "writer",
        "version",
        "business_owner",
        "organization",
        "scope"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "version",
          "checksum"
        ]
      }
    },
    "trusted_actor": {
      "required": [
        "id",
        "authenticated",
        "authorized",
        "organization",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authenticated": {
          "const": true
        },
        "authorized": {
          "const": true
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "type": "object"
    }
  }
}
